{
	"name": "boughtsafe-web",
	"version": "1.0.0",
	"private": true,
	"description": "Boughtsafe installable web app: recall alerts matched to what you bought.",
	"license": "AGPL-3.0-or-later",
	"type": "module",
	"engines": {
		"node": ">=20.19"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"e2e": "playwright test",
		"screenshots": "SCREENSHOTS=1 playwright test tests/e2e/screenshots.spec.ts"
	},
	"dependencies": {
		"@lucide/svelte": "^1.75.0",
		"@zxing/browser": "^0.2.1",
		"@zxing/library": "^0.23.0",
		"idb": "^8.0.3",
		"tesseract.js": "^7.0.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.0",
		"@playwright/test": "1.65.1",
		"@sveltejs/adapter-static": "^3.0.11",
		"@sveltejs/kit": "^2.70.0",
		"@sveltejs/vite-plugin-svelte": "^6.2.0",
		"@types/node": "^22.0.0",
		"eslint": "^9.39.0",
		"eslint-config-prettier": "^10.1.0",
		"eslint-plugin-svelte": "^3.24.0",
		"fake-indexeddb": "^6.2.0",
		"globals": "^16.0.0",
		"jsdom": "^26.0.0",
		"prettier": "^3.10.0",
		"prettier-plugin-svelte": "^3.5.0",
		"svelte": "^5.58.0",
		"svelte-check": "^4.7.0",
		"typescript": "^5.9.0",
		"typescript-eslint": "^8.73.0",
		"vite": "^7.3.0",
		"vitest": "^3.2.0"
	}
}
