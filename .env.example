# Copy to .env and adjust. Used by docker-compose.yml.
POSTGRES_PASSWORD=change-me
WEB_PORT=8080
# Pin a release instead of latest, e.g. 1.0.0
BOUGHTSAFE_VERSION=latest

# Optional: raises openFDA rate limits. https://open.fda.gov/apis/authentication/
OPENFDA_API_KEY=

# Optional: Web Push alerts. Generate with:
#   docker compose run --rm api vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.org

SYNC_INTERVAL_MINUTES=60
